PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-this-to-a-long-random-string
STAFF_USERNAME=desk
STAFF_PASSWORD=change-this-password

# Optional — automatic customer confirmation emails on approve/reject/complete.
# Leave unset to just log the confirmation to the server console instead of sending it.
# For Gmail: SMTP_PASS must be a 16-character Google App Password (not the account
# password) — generate one at myaccount.google.com > Security > 2-Step Verification
# > App passwords, with 2-Step Verification turned on first.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hrthemediator@gmail.com
SMTP_PASS=
FROM_EMAIL=hrthemediator@gmail.com
