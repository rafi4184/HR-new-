# Supabase project settings — Settings → API in your Supabase dashboard.
# VITE_SUPABASE_ANON_KEY is the public "anon" key: safe to expose in the
# browser bundle (it's what Row Level Security is designed to be used with),
# never the service_role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
